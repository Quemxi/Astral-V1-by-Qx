name: Build Astral
on:
  push:
  workflow_dispatch:

jobs:
  build:
    name: Build Astral for Minecraft 26.1.2
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Setup JDK
        uses: actions/setup-java@v4
        with:
          java-version: 25
          distribution: 'microsoft'

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: wrapper

      - name: Make gradlew executable
        run: chmod +x gradlew

      - name: Build
        run: ./gradlew ":26.1:buildAndCollect" --no-daemon

      - name: Upload jar
        uses: actions/upload-artifact@v4
        with:
          name: Astral-26.1.2
          path: build/libs/
